# ====== LLM (litellm 格式 provider/model) ======
#
# 这三行是**冷启动种子**: config/model.json 不存在时, 用它们合成唯一一条候选。
# 起了 Web 前端之后, 在 ⚙ 设置 → 🧠 模型 里加/切模型写的是 config/model.json,
# 切完下一轮对话即生效, 不回写这里也不用重启 —— 那之后这三行就不再被读。
# 只用 CLI (main.py) 的话, 填这三行就够。
#
# base_url 留空 = 走 provider 官方端点; 填 = 走你自己的中转。
PRIMARY_MODEL=anthropic/claude-sonnet-5-5
PRIMARY_API_KEY=sk-REPLACE-ME
PRIMARY_BASE_URL=
#
# 没有主备 fallback (2026-10-15 拍板砍掉): litellm 1.89.3 的 fallbacks 参数跟
# 流式调用有 bug (sync 迭代器拿 async_generator 必崩), 且主挂了静默退化到备用
# 更难查 —— 中转抽风时备用摆烂寒暄, 看不出换了模型。现在挂就直接报错暴露。
# 想换模型就去前端切, 比配一套自动退化更可控。

# ====== LLM 行为参数 (可选, 有默认值) ======
# MAX_ITERS=15            # agent loop 步数上限
# MAX_TOKENS=4096         # 每次 LLM 调用 max_tokens
# REQUEST_TIMEOUT=45      # 单次请求超时 (秒)

# ====== RAG (阶段 1) ======
# 检索后过滤掉低于此分数的 chunk; bge-small-zh 上 0.4 是噪音/相关分水岭
RAG_SCORE_THRESHOLD=0.4
RAG_TOP_K=3
CHUNK_SIZE=300
CHUNK_OVERLAP=50
# 向量库持久化目录 (项目相对路径), 已加入 .gitignore
CHROMA_PERSIST_DIR=chroma_db

# ====== Rerank (阶段 1.5) ======
# 是否启用 cross-encoder 精排 (bge-reranker-v2-m3, 实际 ~2.12GB).
# 启用前需先下模型:
#   uv run modelscope download --model BAAI/bge-reranker-v2-m3 \
#       --local_dir models/bge-reranker-v2-m3
RAG_USE_RERANKER=false

# 粗排候选池大小 (Hybrid 出 N 条交给 reranker 精排 top_k)
RAG_RERANK_CANDIDATES=30

# rerank 分阈值, 跟 cosine 分不在同一尺度 (别直接套 0.4 那个 cosine 老阈值).
# -1.0 = "未校准"哨兵值: main.py 检测到会强警告, 但不阻止启动
# (所有 sigmoid ∈ [0,1] 分都 > -1.0, 等于不过滤).
# ★ 0.50 这个值是在一批中文技术文档语料上实测标定的 (2026-06-17, 5 相关 + 5
#   不相关 query), 不是普适常数 —— corpus/ 现在是你自己的知识库, 换了语料或换
#   reranker 模型都该重标: 跑 tests/manual/smoke_reranker.py 看分数分布再定值。
RAG_RERANK_THRESHOLD=0.50

# ====== Round 2: Lost-in-middle 重排 (阶段 1 债务 ②) ======
# 召回的 chunks ≥ min_chunks 时, 用 odd-front 模式重排 (高分占头尾, 低分挪中间)
RAG_REORDER_ENABLED=true
RAG_REORDER_MIN_CHUNKS=5

# ====== Round 2: History 截断 (阶段 1 债务 ④) ======
# 每轮调 LLM 前按"轮数滑窗 + 字符上限二级保险"截断 conversation history
# (字符上限是粗略估算: GLM/中转无精确 count_tokens, 字符÷2.5 ≈ token)
HISTORY_TRUNCATE_ENABLED=true
HISTORY_MAX_ROUNDS=10
HISTORY_MAX_CHARS=20000

# ============ 数据源 (可配任意数量, 每源自带方言) ============
#
# 怎么配: 两步。
#   ① DB_SOURCES 写源名清单 (逗号分隔, 小写, 顺序无所谓)
#   ② 每个源配一组变量, 变量名 = DB_ + 源名大写 + _字段
#      如源名 lib → DB_LIB_HOST / DB_LIB_PORT / DB_LIB_USER /
#                   DB_LIB_PASSWORD / DB_LIB_NAME / DB_LIB_TYPE
#      源名在 ① 写小写、在 ② 写大写, 解析时统一按小写认。
#
# ★ 源名不是随便起的: 必须与本体里 entity.data_source 的值逐字相同。
#   真正决定"一个查询走哪个库"的是实体上的 data_source, DB_SOURCES 只是
#   把连接池开出来。两边对不上时 **启动不报错**, 要等 agent 真查到那个实体
#   才回 "data source 'xxx' not found" —— 这个契约没有启动期校验, 配完请跑
#   下面的对账命令。(init_ontology 建的 seed 本体用的是 lib, 照抄即可路由。)
#
# 配完自检 (一条命令, 列出本体用到的源 vs 配置提供的源):
#   uv run --frozen python -c "from core.config import settings; \
#   from core.ontology_view import set_ontology, get_ontology; \
#   set_ontology(settings.obda_ontology_path); \
#   u={e.get('data_source') for e in get_ontology().entities.values()}; \
#   print('本体用到:',u,'配置提供:',set(settings.db_sources),'缺:',u-set(settings.db_sources))"
#
# 全留空不影响启动: 连不上只打警告后降级, RAG / 对话照常用, 只有查库类
# 问题 (execute_sql) 会报错。反过来说 —— 配错了也不会炸给你看, 得看启动
# 警告才知道。想接真库再填。
#
# ★ 占位必须留空或用 ASCII: 中文占位 (如 PASSWORD=填密码) 会让驱动在编码
#   阶段抛 UnicodeEncodeError, 报错完全看不出是"你没配库"。
DB_SOURCES=lib

# ---- 源 lib (MySQL 示例) ----
DB_LIB_HOST=
DB_LIB_PORT=3306
DB_LIB_USER=
DB_LIB_PASSWORD=
# MySQL 填数据库名 (Oracle 填 service_name, 见下面 crm 示例)
DB_LIB_NAME=
DB_LIB_TYPE=mysql      # mysql / oracle; 不填默认 mysql

# ---- 加源: DB_SOURCES 追加名字 + 配一组同名变量。以下是 Oracle 示例 ----
# 想同时用 lib 和 crm 两个源, 把下面整段取消注释, 并把上面改成
# DB_SOURCES=lib,crm  (MySQL 与 Oracle 混着配没问题, 已实测三源共存)
# DB_CRM_HOST=db.example.com
# DB_CRM_PORT=1521
# DB_CRM_USER=
# DB_CRM_PASSWORD=
# DB_CRM_NAME=ORCLPDB1   # ★ Oracle 这里填 service_name, 不是 SID / 库名
# DB_CRM_TYPE=oracle
#
# 跨源查询: 两个源之间要能接力, 得在本体里给跨库边标上连接列
# (source_col / target_col)。切段接力由 cross_source_planner 做,
# 不是真 JOIN —— 且跨源那段 SQL 没有 OBQC 校验兜底 (表 resolve 不到会跳过)。

OBDA_ONTOLOGY_PATH=capabilities/ontology/ontology.db

# ---------- 工具信任边界: 部署 profile ----------
# local   = 开发机, 加载全部工具 (含 read_file/list_dir 内省工具)
# serving = 上线,   只加载业务工具 (rag_query/execute_sql/get_entity_cards),
#                   read_file/list_dir 根本不进 agent, 攻击者无法透过 agent 读源码
# 不填 = 缺省 serving (最小暴露, fail-safe)。本地开发务必显式写 local。
#
# 门控同样作用于 MCP server: config/mcp_servers.json 里每条带 category,
# 缺省 local → serving 档位下不加载 (连子进程都不起)。要在上线档位用某个
# MCP server, 显式把它的 category 改成 "serving" (管理面板里也能改)。
# ★ 这一条 2026-10-16 前是漏的: serving 下 MCP 工具照样发给 LLM, 上面
#   "攻击者无法透过 agent 读源码" 当时只对本地工具成立。
#
# ★ 门控管的是"agent 能看见哪些工具", 不管 /config/* 这些管理端点本身 ——
#   web 层没有认证, serving 档位别把它暴露到公网 (见 README 部署一节)。
DEPLOY_PROFILE=local
